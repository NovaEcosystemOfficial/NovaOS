#!/usr/bin/env python3
"""nova-shell launcher installed to /usr/bin."""
from __future__ import annotations

import sys
from pathlib import Path

GUI_ROOT = Path("/usr/share/nova/shell")
DEV_ROOT = Path(__file__).resolve().parents[1]

for root in (GUI_ROOT, DEV_ROOT):
    if (root / "nova_shell" / "app.py").is_file():
        sys.path.insert(0, str(root))
        break

from nova_shell.app import main

if __name__ == "__main__":
    raise SystemExit(main())
