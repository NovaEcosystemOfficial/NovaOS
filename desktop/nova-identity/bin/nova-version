#!/usr/bin/env python3
"""nova-version — print NovaOS version string."""
from __future__ import annotations

import sys
from pathlib import Path


def _path() -> None:
    for root in (Path("/usr/share/nova/identity"), Path(__file__).resolve().parents[1] / "lib"):
        if (root / "nova_identity").is_dir() and str(root) not in sys.path:
            sys.path.insert(0, str(root))
            return


_path()
from nova_identity.facts import collect_about  # noqa: E402


def main() -> int:
    data = collect_about()
    print(f"{data.get('pretty_name', 'NovaOS')} ({data.get('version', '—')})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
