#!/usr/bin/env python3
"""nova-update-gui launcher installed to /usr/bin."""
from __future__ import annotations

import runpy
import sys
from pathlib import Path

GUI_ROOT = Path("/usr/share/nova/update/gui")
DEV_ROOT = Path(__file__).resolve().parents[3] / "desktop" / "nova-update"

for root in (GUI_ROOT, DEV_ROOT):
    if (root / "nova_update_gui" / "app.py").is_file():
        sys.path.insert(0, str(root))
        break

from nova_update_gui.app import main

if __name__ == "__main__":
    sys.exit(main())
