[Desktop Entry]
Type=Application
Version=1.0
Name=Nova Welcome
Comment=NovaOS first-boot welcome (autostart)
Exec=nova-welcome
TryExec=nova-welcome
Icon=preferences-desktop-theme
Terminal=false
Categories=Qt;Settings;System;
OnlyShowIn=KDE;GNOME;LXQt;XFCE;
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
X-KDE-StartupNotify=false
NoDisplay=true
X-NovaOS-Component=nova-welcome-autostart
X-NovaOS-API=welcome.v1
X-NovaOS-Version=0.2.3
