#!/usr/bin/env python3
"""nova-launcher entry point."""
from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path("/usr/share/nova/launcher")
DEV = Path(__file__).resolve().parents[1]
for root in (ROOT, DEV):
    if (root / "nova_launcher" / "app.py").is_file():
        sys.path.insert(0, str(root))
        break

from nova_launcher.app import main

if __name__ == "__main__":
    raise SystemExit(main())
